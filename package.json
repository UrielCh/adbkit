{
    "name": "@u4/adbkit",
    "version": "5.2.0",
    "description": "A Typescript client for the Android Debug Bridge.",
    "type": "module",
    "keywords": [
        "adb",
        "adbkit",
        "android",
        "logcat",
        "typescript",
        "monkey",
        "scrcpy"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "bin": {
        "adbkit": "./bin/adbkit"
    },
    "bugs": {
        "url": "https://github.com/UrielCh/adbkit/issues"
    },
    "license": "Apache-2.0",
    "funding": "https://github.com/sponsors/urielch",
    "author": {
        "name": "openstf",
        "email": "contact@openstf.io",
        "url": "https://uriel.ovh"
    },
    "contributors": [
        {
            "name": "uriel chemouni",
            "email": "uchemouni@gmail.com",
            "url": "https://uriel.ovh"
        }
    ],
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "repository": {
        "type": "git",
        "url": "https://github.com/UrielCh/adbkit.git"
    },
    "scripts": {
        "clean": "rimraf dist",
        "keycode": "tsx tasks/keycode.ts",
        "servicemap": "tsx tasks/servicemap.ts",
        "download:scrcpy": "tsx tasks/downloadScrcpy.ts",
        "test:video": "tsx tasks/testVideo.ts",
        "prepublish": "npm run clean && npm run compile",
        "docker-clean": "npx --yes modclean -r",
        "docs": "typedoc --entryPointStrategy expand",
        "compile": "tsc -p .",
        "build": "tsc -p .",
        "lint": "eslint .",
        "format": "eslint . --fix",
        "test": "mocha -r tsx --reporter spec --colors test/**/*.ts",
        "test2": "mocha -r tsx --reporter spec --colors test/adb/thirdparty/**/*.ts",
        "test3": "mocha -r tsx --reporter spec --colors test/adb/command/host-transport/serviceCall.ts",
        "typetest": "npx --yes @arethetypeswrong/cli --pack .",
        "ncu": "npx npm-check-updates -i"
    },
    "dependencies": {
        "@u4/adbkit-logcat": "2.1.2",
        "@u4/adbkit-monkey": "^1.0.5",
        "@u4/minicap-prebuilt": "^1.1.2",
        "@xmldom/xmldom": "^0.9.12",
        "commander": "15.1.0",
        "debug": "~4.4.3",
        "get-port": "7.2.0",
        "node-forge": "^1.4.3",
        "promise-duplex": "^8.0.0",
        "promise-readable": "^8.0.1",
        "protobufjs": "^8.8.1",
        "xpath": "^0.0.36"
    },
    "devDependencies": {
        "@jest/globals": "^30.5.2",
        "@types/debug": "^4.1.13",
        "@types/jest": "^30.0.0",
        "@types/mocha": "^10.0.10",
        "@types/node": "^24.19.2",
        "@types/node-forge": "^1.3.14",
        "@types/sinon": "^22.0.2",
        "@types/sinon-chai": "^4.0.1",
        "@typescript-eslint/eslint-plugin": "^8.72.1",
        "@typescript-eslint/parser": "^8.72.1",
        "chai": "~6.3.0",
        "eslint": "^10.14.0",
        "jest": "^30.5.2",
        "mocha": "~12.0.3",
        "picocolors": "^1.1.1",
        "prettier": "^3.9.10",
        "rimraf": "^6.1.4",
        "sinon": "~22.1.0",
        "sinon-chai": "~4.0.1",
        "tsx": "^4.23.15",
        "typedoc": "^0.28.20",
        "typedoc-plugin-rename-defaults": "^0.7.3",
        "typescript": "5.9.3",
        "why-is-node-running": "^3.2.3"
    },
    "engines": {
        "node": ">= 12.20.0"
    },
    "files": [
        "dist",
        "bin"
    ],
    "optionalDependencies": {
        "@yume-chan/adb": "^3.0.0-beta.5",
        "@yume-chan/adb-credential-nodejs": "^3.0.0-beta.5",
        "@yume-chan/adb-daemon-webusb": "^3.0.0-beta.5",
        "usb": "^3.3.0"
    }
}
